# 기본은 로컬 Ollama — 키 불필요
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# 비교용 (선택) — Claude 직접
ANTHROPIC_API_KEY=
MODEL=claude-haiku-4-5

# 비교용 (선택) — OpenAI 호환 엔드포인트 (게이트웨이·vLLM·LiteLLM). LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EMBED_MODEL=BAAI/bge-m3
RETRIEVAL_MODE=hybrid_rerank # hybrid_rerank(기본, cross-encoder 재정렬) | hybrid | vector | bm25 | bm25_ws
GRADE_MODE=rerank            # rerank(기본, LLM 호출 0) | llm
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_THRESHOLD=0.2
TOP_K=5
MAX_ATTEMPTS=2
CHUNK_SIZE=900               # 업로드 문서 본문 청크 상한(글자). KorQuAD는 문단 그대로
CHUNK_OVERLAP=100

# OCR — 텍스트 레이어 없는 PDF 페이지·PNG/JPG (easyocr). 첫 실행 때 모델 ~100MB 다운로드
OCR_ENABLED=true
OCR_LANGS=ko,en
OCR_DPI=200
OCR_GPU=false                # CUDA 있을 때만 true
